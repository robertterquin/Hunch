# Supabase project root URL, without /rest/v1/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Never expose this value through Vite client code.
# Never rename this to VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional shared production rate limiting. Leave blank for local fallback.
# These values are server-side only and must not use the VITE_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
