# Supabase project root URL, without /rest/v1/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Never expose this value through Vite client code.
# Never rename this to VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional server-side fallback for low-confidence screenshot OCR.
# Create a restricted Google Cloud Vision API key. Never use a VITE_ prefix.
GOOGLE_CLOUD_VISION_API_KEY=
